# ===========================================================================
# Job Agent Local — configuration
# Copy this file to ".env" and fill in your values:  cp .env.example .env
# ===========================================================================

# --- AI provider (required) -------------------------------------------------
# Which LLM provider to use for extraction / scoring / tailoring.
#   anthropic  -> uses the Anthropic Messages API
#   openai     -> uses the OpenAI Chat Completions API (or any OpenAI-compatible URL)
AI_PROVIDER=anthropic

# Your API key for the provider above.
AI_API_KEY=

# Base model for the high-volume work. Blank = provider default
# (anthropic: claude-haiku-4-5, openai: gpt-4o-mini).
AI_MODEL=

# --- Per-task models (override individually; blank = the defaults below) -----
# extraction + first-pass scoring stay cheap; tailoring + the confirm-pass use
# the stronger model. The cascade re-scores any job the first pass rates ABOVE
# RESCORE_THRESHOLD with MODEL_RESCORE (set MODEL_RESCORE = MODEL_SCORE to disable).
MODEL_EXTRACT=          # default: AI_MODEL (Haiku)
MODEL_SCORE=            # default: AI_MODEL (Haiku)
MODEL_RESCORE=          # default: claude-sonnet-4-6
MODEL_TAILOR=           # default: claude-sonnet-4-6
RESCORE_THRESHOLD=70

# Optional: override the base URL (useful for OpenAI-compatible gateways,
# local LLMs via Ollama/LM Studio, OpenRouter, etc.). Leave blank for default.
AI_BASE_URL=

# --- Performance knobs ------------------------------------------------------
# How many job-board sources to scrape in parallel. Higher = faster but heavier.
SCRAPE_CONCURRENCY=6
# How many job pages to open per source in parallel.
PAGE_CONCURRENCY=4
# Max milliseconds to wait for a page's network to settle (smart wait, not fixed).
PAGE_TIMEOUT_MS=15000
# How many jobs to score per single AI call (batched scoring = big speedup).
SCORE_BATCH_SIZE=10
# How many scoring batches to run in parallel (same token cost, faster wall clock).
SCORE_CONCURRENCY=4

# --- Server -----------------------------------------------------------------
PORT=5179

# Optional: Microsoft Graph token for the 2FA email-code helper (POST /api/2fa).
# Leave blank to disable.
OUTLOOK_GRAPH_TOKEN=

# --- Scheduled scrape + email digest (for always-on hosting) ----------------
# How often to auto-scrape, in hours. 0 (default) = scheduler OFF. Set to 4 on
# your host to scrape every 4 hours.
SCRAPE_INTERVAL_HOURS=0
# Only email jobs scoring at/above this. Tier 1 starts at 85.
DIGEST_MIN_SCORE=85
# Resend API key (https://resend.com -> API Keys). Required to send the digest.
RESEND_API_KEY=
# Where to send the digest. In Resend test mode this MUST be your Resend account
# email; verify a domain to send anywhere.
DIGEST_TO=
# From address. Default works in Resend test mode; change once you verify a domain.
DIGEST_FROM=Job Agent <onboarding@resend.dev>

# --- Access control (recommended when hosting publicly) ---------------------
# If set, the whole app requires this password (HTTP Basic Auth; any username).
# Leave blank for local-only use.
APP_PASSWORD=

# Optional second password for READ-ONLY demo access (any username).
# Viewers see the board only: no scraping, no settings, no resume/tailored docs.
VIEWER_PASSWORD=
